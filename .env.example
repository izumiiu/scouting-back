NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
MONGODB_URI=
# Generate a random value with at least 32 characters. Never commit actual secrets.
JWT_SECRET=
# Choose openai or groq. Only the selected provider receives requests.
AI_PROVIDER=openai
GROQ_API_KEY=
# Initial test candidate; verify model access, quotas and Thai output quality.
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
# Set a model your API project can access that supports Responses + Structured Outputs.
OPENAI_MODEL=
ENABLE_WORKER=true
FRONTEND_DIST_PATH=../frontend/dist
# Used only by npm run create-officer; remove password after creating the account.
OFFICER_EMAIL=
OFFICER_PASSWORD=
OFFICER_NAME=เจ้าหน้าที่ NU SEED
ORGANIZATION_ID=nu-seed
